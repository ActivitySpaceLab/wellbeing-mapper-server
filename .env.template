# Configuration of the Wellbeing Mapper server, one variable per line.
#
# Docker Compose reads this file as `.env` next to docker-compose.yml and
# passes the values below into the container. With systemd, install it as
# /etc/wellbeing-mapper-server.env (see deploy/systemd/). Every variable has
# the default shown; delete a line to keep the default.

NODE_ENV=production
PORT=3000

# Where submissions are stored, one JSON file each, and the participant-code
# file (hashes only; see generate_participant_codes.py). Both live on the
# data volume; back it up. Docker Compose sets these to /data/... itself.
#STORAGE_DIR=./received
#PARTICIPANT_CODES_FILE=./participant_codes.json

# Largest accepted request. A biweekly survey carries two weeks of location
# history inside its encrypted payload, so keep this generous.
MAX_REQUEST_SIZE=25mb

# Uploads are refused with 507 (and retried by the app later) when the storage
# volume has less than this much free space, so the server never fills the
# disk completely.
MIN_FREE_MB=500

# Rate limits per client address per 10 minutes. Many participants can share
# one address (a campus network, a mobile carrier), so keep these well above
# what one person needs. 0 disables a limit.
RATE_LIMIT_VALIDATE_PER_10MIN=60
RATE_LIMIT_UPLOAD_PER_10MIN=300

# Which proxies to trust for the client address (Express "trust proxy"). The
# default trusts a reverse proxy on the same host or Docker network, i.e.
# Caddy. Set to false if the app talks to Node directly.
#TRUST_PROXY=loopback, linklocal, uniquelocal

# Browser origins allowed by CORS. The mobile app does not send an Origin
# header, so this only matters for browser-based tools.
ALLOWED_ORIGINS=*
