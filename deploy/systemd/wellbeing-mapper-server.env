# Environment for the systemd service; install to /etc/wellbeing-mapper-server.env
# (root-owned, mode 0640). See .env.template for what each variable does.
NODE_ENV=production
PORT=3000
STORAGE_DIR=/var/lib/wellbeing-mapper/received
PARTICIPANT_CODES_FILE=/var/lib/wellbeing-mapper/participant_codes.json
MAX_REQUEST_SIZE=25mb
MIN_FREE_MB=500
RATE_LIMIT_VALIDATE_PER_10MIN=60
RATE_LIMIT_UPLOAD_PER_10MIN=300
